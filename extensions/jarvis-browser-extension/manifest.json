{
  "manifest_version": 3,
  "name": "Jarvis Desktop Browser Companion",
  "version": "1.0.0",
  "description": "Enables Jarvis to detect, reuse, and activate desktop browser tabs without duplicate tab creation.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jarvis Browser Companion"
  }
}
